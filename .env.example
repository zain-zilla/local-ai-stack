# Copy this file to .env and fill in your own values.
# Never commit .env: it holds your database password and n8n's encryption key.

# Any long random password for the n8n database
POSTGRES_PASSWORD=change-me

# Encrypts the credentials (API keys) that n8n stores. Make one with:
#   PowerShell:  $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); ($b | % ToString x2) -join ''
#   Linux/macOS: openssl rand -hex 32
# Back it up somewhere safe: without it, saved credentials can't be decrypted.
N8N_ENCRYPTION_KEY=change-me

# Your time zone (used by schedules)
TIMEZONE=Asia/Ho_Chi_Minh
